{
  "name": "soundstorm-demo-electron",
  "version": "0.8.8",
  "private": true,
  "description": "Steam desktop package of the first-stage SoundStorm web demo.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "verify:demo": "node electron/verify-demo.cjs",
    "build:mac": "npm run verify:demo && node electron/verify-icon.cjs && electron-builder --mac --universal --dir --publish never",
    "build:win": "npm run verify:demo && node electron/verify-icon.cjs && electron-builder --win --x64 --dir --publish never",
    "steam:vdf:mac": "node steam/generate-demo-vdf.cjs mac",
    "steam:vdf:win": "node steam/generate-demo-vdf.cjs win"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "ch.uhx.soundstorm.demo",
    "productName": "SoundStorm Demo",
    "copyright": "Copyright UHX",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "index.html",
      "env.js",
      "code/**/*",
      "pics/**/*",
      "sounds/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json",
      "!**/.DS_Store",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.games"
    },
    "win": {},
    "linux": {
      "category": "Game"
    }
  }
}
